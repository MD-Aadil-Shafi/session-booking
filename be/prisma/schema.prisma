generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MEMBER 
  PROFESSIONAL
}

enum SessionStatus {
  BOOKED
  CANCELLED
}

enum ReminderType {
  BEFORE_24_HOURS
  BEFORE_1_HOUR
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
}


model User {
  id String @id @default(uuid()) @db.Uuid
  firstName String @db.VarChar(12)
  lastName String @db.VarChar(12)

  email String @unique @db.VarChar(50)
  country String? @db.VarChar(60)
  age Int?
  role Role @default(MEMBER)
  password String
  isActive Boolean @default(true)
  timezone String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([firstName, lastName, role])

  @@map("users")

  // using one to many for multiple device login/logout
  refreshToken RefreshToken[]
  workingHours ProfessionalHours[]

  memberSessions Session[] @relation("MemberSessions")
  professionalSessions Session[] @relation("ProfessionalSessions")

  reminders     Reminder[]
  notifications Notification[]
}

model RefreshToken {
  id BigInt @id @default(autoincrement())
  token String @unique
  expires_at DateTime
  user_id String @db.Uuid
  user_role String
  createdAt DateTime @default(now())

  @@index([user_id])
  @@map("refresh-tokens")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model ProfessionalHours {
  id String @id @default(uuid()) @db.Uuid
  professionalId String @db.Uuid
  dayOfWeek Int
  startTime String
  endTime String

  professional User @relation( fields: [professionalId], references: [id], onDelete: Cascade)

//combination of prof id and day should be unique => P1 + Monday
//now same professional can not re create p1 + monday
  @@unique([professionalId, dayOfWeek])
}

model Session {
  id             String @id @default(uuid()) @db.Uuid

  memberId       String @db.Uuid
  professionalId String @db.Uuid

  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)

  status         SessionStatus @default(BOOKED)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member User @relation( "MemberSessions", fields: [memberId], references: [id])

  professional User @relation("ProfessionalSessions", fields: [professionalId], references: [id])

  reminders Reminder[]

  @@index([memberId, startsAt])
  @@index([professionalId, startsAt])
}

model Reminder {
  id        String @id @default(uuid()) @db.Uuid

  sessionId String @db.Uuid
  userId    String @db.Uuid

  type      ReminderType
  status    ReminderStatus @default(PENDING)

  scheduledAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now())
  sentAt    DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notification Notification?

  @@index([status, scheduledAt])
}

model Notification {
  id         String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  reminderId String? @unique @db.Uuid

  title      String
  message    String

  readAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}